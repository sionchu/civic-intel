{
  "name": "@civic-intel/web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "build:worker": "node scripts/build-worker.mjs worker",
    "build:sites": "node scripts/build-worker.mjs sites",
    "check:worker": "node scripts/check-worker.mjs",
    "check:standalone": "node scripts/check-standalone.mjs",
    "check:portraits": "node scripts/check-portrait-assets.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-portrait-assets.mjs && node --conditions=react-server --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "cytoscape": "3.34.3",
    "next": "^16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.8",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "^5.9.0",
    "vinext": "1.0.1",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  },
  "overrides": { "fflate": "0.8.3" }
}
